# DecentAI's settings, one file for the whole Compose stack (documentation/api-server.md §11, runtime.md §9,
# sandbox.md).
#
# On your own computer, don't fill this in: `python deploy/setup/setup.py` writes deploy/config/deploy.env from it,
# every change-me replaced by a generated value. As written, the file is for that: one computer, plain HTTP, this
# machine only. For a server, copy it to deploy/config/deploy.env, replace every change-me, and set what the
# "On a server" notes say.
#
# The API server is handed this file whole, but for the database's root password and the issuer's. The runtime and
# the sandbox are handed only the settings deploy/docker-compose.yml names for each.

# ── What the stack is made of ────────────────────────────────────────────────────────────────────────
# The Compose files, separated by colons, named from the repository root. A second sandbox:
# deploy/docker-compose.yml:deploy/sandboxes.yml. A server: deploy/docker-compose.yml:deploy/server.yml.
COMPOSE_FILE=deploy/docker-compose.yml
COMPOSE_PATH_SEPARATOR=:
# The release the images come from (0.6.0). Unset, they are built from this checkout.
# DECENTAI_VERSION=
# DECENTAI_IMAGES=ghcr.io/decentai-io

# ── Where it is reached ──────────────────────────────────────────────────────────────────────────────
# The API server's published port, and who may reach it: this computer alone. On a server: the port the proxy
# holding the TLS forwards to, and LISTEN=0.0.0.0 where that proxy is on another host, with deploy/server.yml.
PORT=4280
LISTEN=127.0.0.1
# Its own address, as browsers and OAuth providers reach it. On a server: https:// and its domain.
AI_API_URL=http://localhost:4280
# Where people open the web client, and every origin it is served from, comma-separated: the only ones answered.
# Never a wildcard.
AI_API_APP_URL=http://localhost:4300
AI_API_ORIGINS=http://localhost:4300,http://localhost:4200
# The proxies whose forwarded headers it believes, by address or range as it sees them. On a server: the proxy.
AI_API_PROXIES=127.0.0.1

# ── MongoDB, as a replica set of one ─────────────────────────────────────────────────────────────────
# The root account, which the database is made with. Only the step that makes the API server's account is given it.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me
# The API server's account, made at every start with the rights it needs: everything but the trail, where it only
# adds. A password in this address is URL-safe.
AI_API_DATABASE_URI=mongodb://api:change-me@mongo:27017/?replicaSet=rs0&authSource=decentai
AI_API_DATABASE_NAME=decentai
# The issuer's account, on its own database (decentai_issuer), made with the database.
ISSUER_DATABASE_PASSWORD=change-me

# ── Its keys ─────────────────────────────────────────────────────────────────────────────────────────
# AES-256 keys, each 32 bytes in base64, as version:key, comma-separated; the active one seals. A key:
#   python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# To rotate: add a key, make it active, `python -m api_server.admin reencrypt` in the API server, drop the old one.
AI_API_ENCRYPTION_KEYS=01:change-me
AI_API_ENCRYPTION_ACTIVE=01
# What encrypts the issuer's intermediate key on its volume, so a copy of the volume alone signs nothing. Kept here,
# not beside the key. The issuer doesn't start without it.
ISSUER_KEY_PASSPHRASE=change-me

# ── First run ────────────────────────────────────────────────────────────────────────────────────────
# The code the first-run page asks for. Until the first run is done the API server doesn't start without it; it is
# never written to a log.
AI_API_SETUP_CODE=change-me
# "open": anybody may make an organization from the sign-in page, where mail is set up. "closed": they are made with
# `python -m api_server.admin organizations create` in the API server.
AI_API_SIGNUP=closed
# Whose administrators make shared enrollment tokens and install an issuer's intermediate. Empty: the first one made.
# AI_API_OPERATOR_ORG=

# ── Mail: invitations, sign-up and password reset links ─────────────────────────────────────────────
# Without a host and a sender, people join by a temporary password, and there are no links. Security: starttls
# (587), tls (465) or none.
# AI_API_SMTP_HOST=
# AI_API_SMTP_PORT=587
# AI_API_SMTP_SECURITY=starttls
# AI_API_SMTP_USERNAME=
# AI_API_SMTP_PASSWORD=
# AI_API_MAIL_FROM=

# ── Web push (deploy/setup/generate_vapid_keys.py) ──────────────────────────────────────────────────
# AI_API_VAPID_PUBLIC_KEY=
# AI_API_VAPID_PRIVATE_KEY=
# AI_API_VAPID_SUBJECT=mailto:admin@example.com

# ── Where files and programs are kept ────────────────────────────────────────────────────────────────
# local: the storage volume, which every API server of the stack shares. s3: Amazon S3, or a store that speaks it.
AI_API_STORAGE=local
# AI_API_S3_BUCKET=
# AI_API_S3_REGION=
# AI_API_S3_ENDPOINT=
# AI_API_S3_PREFIX=
# AI_API_S3_ACCESS_KEY_ID=
# AI_API_S3_SECRET_ACCESS_KEY=
# AI_API_S3_KMS_KEY_ID=

# ── The rest of the API server's ─────────────────────────────────────────────────────────────────────
# A catalog address the Agents page suggests; hosts inside the deployment addresses people give may reach.
# AI_API_REFERENCE_CATALOG=
# AI_API_INSIDE_HOSTS=
# Its limits, as documentation/api-server.md §9 names them, such as:
# AI_API_UPLOAD_MAX_MIB=25
# AI_API_CALLS_PER_MINUTE=600
AI_API_LOG_LEVEL=INFO

# ── The runtime's (documentation/runtime.md §9) ──────────────────────────────────────────────────────
# AI_RUNTIME_AGENT_PROCESS_IDLE_MINUTES=12
# AI_RUNTIME_AGENT_READY_SECONDS=60
# AI_RUNTIME_AGENT_CANCEL_SECONDS=5
# AI_RUNTIME_AGENT_CONNECTIONS_MAX=128
# AI_RUNTIME_LOG_LEVEL=INFO
# Model hosts inside this network a model connection may reach, by name or as a network such as 10.0.0.0/8: a model
# served on your own machines. Empty: models are reached at public addresses only.
# AI_RUNTIME_INSIDE_HOSTS=

# ── The sandbox's (documentation/sandbox.md) ─────────────────────────────────────────────────────────
# What its processes are given together: memory (2g, 1500m; unset, 4g) and processors (2, 1.5; unset, no limit).
# SANDBOX_MEMORY=4g
# SANDBOX_CPUS=2
# AI_SANDBOX_PROCESSES_MAX=
# AI_SANDBOX_PROCESS_MEMORY_MIB=
# AI_SANDBOX_PROCESS_MEMORY_MAX_MIB=
# AI_SANDBOX_LOG_LEVEL=INFO

# ── Speech ───────────────────────────────────────────────────────────────────────────────────────────
# What the speech container fetches as it first starts: speech to text (about 490 MB) unless this says otherwise.
# Set and empty, nothing; "transcription,speech", the voices as well.
# SPEECH_FETCH=
