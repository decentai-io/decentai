# The API server's settings (documentation/api-server.md §9, §11). Every one is read from the environment; replace
# every change-me value. Limits not named here keep their defaults.

# Where it listens and how it is reached.
AI_API_ADDRESS=0.0.0.0:8000
AI_API_URL=http://localhost:8000
AI_API_APP_URL=http://localhost:4200
AI_API_PROXIES=127.0.0.1
AI_API_IDENTITY=/run/decentai/api

# MongoDB, as a replica set (one node is enough).
AI_API_DATABASE_URI=mongodb://localhost:27017/?replicaSet=rs0
AI_API_DATABASE_NAME=decentai

# Versioned AES-256 keys, each 32 bytes in base64: version:key, comma-separated. The active one seals.
AI_API_ENCRYPTION_KEYS=01:change-me
AI_API_ENCRYPTION_ACTIVE=01

# Where files and programs are kept: local (one folder every API server shares) or s3.
AI_API_STORAGE=local
AI_API_STORAGE_FOLDER=/data/storage

# Mail: without it, people join by a temporary password, and there are no reset or sign-up links.
# AI_API_SMTP_HOST=
# AI_API_SMTP_PORT=587
# AI_API_SMTP_USERNAME=
# AI_API_SMTP_PASSWORD=
# AI_API_MAIL_FROM=

# First run: the setup code; left out, one is written to the log.
# AI_API_SETUP_CODE=change-me
AI_API_SIGNUP=closed

# Hosts inside the deployment that addresses people give may reach, such as an internal catalog.
# AI_API_INSIDE_HOSTS=
