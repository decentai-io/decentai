{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "The agents standard's manifest and catalog, schema 3 (documentation/agents.md §5, §10).",
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 200},
    "words": {"type": "string", "maxLength": 4000},
    "https": {"type": "string", "pattern": "^https://", "maxLength": 2000},
    "file": {
      "type": "object", "additionalProperties": false, "required": ["url", "digest", "size"],
      "properties": {
        "url": {"type": "string", "minLength": 1, "maxLength": 2000},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 1}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "properties": {"cardinality": {"enum": ["one", "many"]}, "required": {"type": "boolean"}}
    },
    "field": {
      "type": "object", "additionalProperties": false, "required": ["name", "type"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "label": {"$ref": "#/$defs/text"},
        "type": {"enum": ["string", "number", "select", "object", "secret", "form"]},
        "storage": {"enum": ["keys", "values"]},
        "required": {"type": "boolean"},
        "options": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 100}}
      }
    },
    "fields": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/field"}},
    "oauth": {
      "type": "object", "additionalProperties": false, "required": ["provider", "authorize_url", "token_url"],
      "properties": {
        "provider": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$"},
        "authorize_url": {"$ref": "#/$defs/https"},
        "token_url": {"$ref": "#/$defs/https"},
        "scopes": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "authorize_params": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 200}},
        "identity": {
          "type": "object", "additionalProperties": false, "required": ["url", "field"],
          "properties": {
            "url": {"$ref": "#/$defs/https"},
            "field": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*){0,5}$"},
            "method": {"enum": ["GET", "POST"]},
            "headers": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 200}},
            "source": {"enum": ["identity", "token"]}
          }
        },
        "scope_param": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"},
        "scope_separator": {"enum": [" ", ","]},
        "token_auth": {"enum": ["body", "basic"]},
        "token_format": {"enum": ["form", "json"]},
        "token_path": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*){0,5}$"}
      }
    },
    "secret": {
      "type": "object", "additionalProperties": false, "required": ["id", "label"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/text"}, "description": {"$ref": "#/$defs/words"},
        "binding": {"$ref": "#/$defs/binding"}, "fields": {"$ref": "#/$defs/fields"}, "oauth": {"$ref": "#/$defs/oauth"}
      }
    },
    "data": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "fields"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/text"}, "description": {"$ref": "#/$defs/words"},
        "binding": {"$ref": "#/$defs/binding"}, "fields": {"$ref": "#/$defs/fields"},
        "user_access": {"type": "array", "uniqueItems": true, "items": {"enum": ["create", "update"]}}
      }
    },
    "files": {
      "type": "object", "additionalProperties": false, "required": ["id", "label"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/text"}, "description": {"$ref": "#/$defs/words"},
        "binding": {"$ref": "#/$defs/binding"},
        "user_access": {"type": "array", "uniqueItems": true, "items": {"enum": ["create"]}},
        "constraints": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "mime_types": {"type": "array", "maxItems": 50, "items": {"type": "string", "pattern": "^[a-z]+/[a-z0-9.+*-]+$"}},
            "max_size_mb": {"type": "integer", "minimum": 1, "maximum": 1024}
          }
        }
      }
    },
    "function": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "description", "level", "inputs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"$ref": "#/$defs/text"},
        "description": {"$ref": "#/$defs/words"},
        "level": {"enum": [0, 1, 2, 3]},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "inputs": {"type": "object"},
        "outputs": {"type": "object"},
        "calls": {
          "type": "array", "uniqueItems": true, "maxItems": 50,
          "items": {"type": "string",
                    "pattern": "^(model|chat|network\\.open|record\\.(list|read|create|update|delete):[a-z][a-z0-9_]{0,39})$"}
        },
        "authorization": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "additionalProperties": false, "required": ["from_input"],
            "properties": {"from_input": {"$ref": "#/$defs/id"}, "required": {"type": "boolean"}}
          }
        },
        "schedulable": {"type": "boolean"}
      }
    },
    "host": {
      "oneOf": [
        {"type": "string",
         "pattern": "^(any|(\\*\\.)?[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+(:[0-9]{1,5})?)$"},
        {"type": "object", "additionalProperties": false, "required": ["from_secret"],
         "properties": {"from_secret": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}\\.[a-z][a-z0-9_]{0,39}$"}}}
      ]
    },
    "manifest": {
      "type": "object", "additionalProperties": false, "required": ["schema", "agent", "functions"],
      "properties": {
        "schema": {"const": 3},
        "agent": {
          "type": "object", "additionalProperties": false, "required": ["id", "name", "version", "description"],
          "properties": {
            "id": {"$ref": "#/$defs/id"},
            "name": {"$ref": "#/$defs/text"},
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]{1,40})?$"},
            "description": {"$ref": "#/$defs/words"},
            "instructions": {"$ref": "#/$defs/words"},
            "examples": {
              "type": "array", "maxItems": 6,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["title", "prompt"],
                "properties": {"title": {"type": "string", "minLength": 1, "maxLength": 80},
                               "prompt": {"type": "string", "minLength": 1, "maxLength": 500}}
              }
            },
            "tags": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 40}}
          }
        },
        "functions": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/function"}},
        "authorization": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "scopes": {
              "type": "object",
              "additionalProperties": {
                "type": "object", "additionalProperties": false, "required": ["description"],
                "properties": {"description": {"$ref": "#/$defs/words"},
                               "normalization": {"enum": ["lowercase", "uppercase"]}}
              }
            }
          }
        },
        "resources": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "secrets": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/secret"}},
            "data": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/data"}},
            "files": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/files"}}
          }
        },
        "network": {
          "type": "object", "additionalProperties": false,
          "properties": {"hosts": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/host"}}}
        }
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false, "required": ["manifest", "programs"],
      "properties": {
        "manifest": {"type": "object"},
        "programs": {
          "type": "object", "minProperties": 1, "propertyNames": {"enum": ["x86_64", "aarch64"]},
          "additionalProperties": {"$ref": "#/$defs/file"}
        },
        "base": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,39}$"},
        "samples": {"$ref": "#/$defs/file"},
        "readme": {"type": "string", "maxLength": 20000}
      }
    },
    "catalog": {
      "type": "object", "additionalProperties": false, "required": ["schema", "catalog", "agents"],
      "properties": {
        "schema": {"const": 3},
        "catalog": {
          "type": "object", "additionalProperties": false, "required": ["id", "name"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/text"}}
        },
        "agents": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/entry"}}
      }
    }
  }
}
