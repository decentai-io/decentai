# Settings and secrets, kept on the machine that made them: the
# install's own files in config/, beside the templates that are kept.
config/deploy.env
config/sandbox.env
config/node-authority.env
config/.*.incoming
# What one person lays over the stack on their own computer: a folder
# of agents they write (docs/agents/developing.md).
docker-compose.override.yml
**/config.env
!**/config.env.example
.env
.env.*
!.env.example
*.pem
*.key

# Python
**/__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# What a local Data Core and its tests write
data_core/uploads/
data_core/data/
data_core/tests/.uploads/
data_core/tests/.agent-packages/
*.log
# written at run time by a dependency
state.json

# What a local runtime and its tests write
ai_runtime/installed_agents/
ai_runtime/tests/.workerenv/

# Editors and operating systems
.idea/
.vscode/
.history/
.claude/
.DS_Store
Thumbs.db
**/.workerenv-build/
