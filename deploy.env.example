# DecentAI deployment configuration — one file for the whole compose
# stack. Copy to deploy.env, replace every change-me, then:
#
#   docker compose --env-file deploy.env up -d --build
#
# The backend and the seeder are handed this file whole. The runtime is
# handed only the settings docker-compose.yml names for it, because
# agent code runs in its container: a new setting for the runtime is
# named there as well as set here.
#
# Three generated values, three generators:
#   python bootstrap/generate_service_keys.py    → the RS256 service pair
#   python bootstrap/generate_secret_keys.py     → the AES-256-GCM secret keys
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#                                                → TOKEN_SECRET_KEY
# and one optional, for notifications on phones and desktops:
#   python bootstrap/generate_vapid_keys.py      → the VAPID pair

# ── Public address ───────────────────────────────────────────────────
# Where users reach the app. A real domain (with DNS pointing at this
# host) gets automatic Let's Encrypt certificates; "localhost" or an IP
# gets a self-signed certificate from Caddy's internal CA.
SITE_ADDRESS=localhost
PUBLIC_APP_URL=https://localhost
CORS_ALLOW_ORIGINS=https://localhost
# Where OAuth providers send the browser back after consent. Leave empty
# to use PUBLIC_APP_URL/oauth/callback (Caddy proxies it to the API);
# register that exact address with every provider app.
OAUTH_REDIRECT_URL=

# What this deployment is: web (served to an organization at an address
# of its own) or desktop (on one person's computer, which the launcher
# sets). Empty is web. It decides what cannot be the same for both: on
# a desktop a connected app may be registered without a secret.
DEPLOYMENT_KIND=

# ── MongoDB ──────────────────────────────────────────────────────────
# The URI carries the same credentials — keep the three lines in sync.
MONGO_ROOT_USERNAME=decentai
MONGO_ROOT_PASSWORD=change-me
MONGO_URI=mongodb://decentai:change-me@mongo:27017/?authSource=admin
MONGO_DATABASE_NAME=decentai

# ── Service topology (compose service names — leave as is) ───────────
AI_RUNTIME_URL=http://ai-runtime:8001
# ...and how the runtime reaches the backend's gateway (its services:
# the chat's contract, state, messages, packages). The Compose service
# name here; 127.0.0.1 where both run in one container group.
BACKEND_INTERNAL_URL=http://backend:8000
# Where agents installed from a repository are kept (a volume, so an
# approved agent survives a restart).
AI_RUNTIME_AGENTS_INSTALL_DIR=/data/agents
# Caddy is the only hop in front of the backend, on the private compose
# network — trust its X-Forwarded-* headers.
FORWARDED_ALLOW_IPS=*

# ── First-run seeding ────────────────────────────────────────────────
ORG_NAME=DecentAI
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ── Authentication ───────────────────────────────────────────────────
TOKEN_SECRET_KEY=change-me
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAMESITE=lax

# ── Service identity (bootstrap/generate_service_keys.py) ────────────
# One line each, exactly as printed (\n escapes preserved).
BACKEND_SERVICE_PRIVATE_KEY=change-me
BACKEND_SERVICE_PUBLIC_KEY=change-me

# ── Encrypted data (bootstrap/generate_secret_keys.py) ───────────────
SECRET_ENCRYPTION_KEYS=01:change-me
SECRET_ENCRYPTION_ACTIVE=01

# ── Outbound email (invitations, password resets) ────────────────────
# Unset, the platform LOGS each message with its link instead of sending
# it and says so in the response. That is deliberate - it keeps a
# development deployment usable without a mail provider - but it means a
# production deployment that forgets this silently never delivers.
#
# Any provider's SMTP server. SMTP_HOST and MAIL_FROM are the switch:
# without both nothing is sent. SMTP_SECURITY is starttls (port 587),
# ssl (port 465) or none; MAIL_FROM must be an address the server lets
# you send as.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# ── Notifications (bootstrap/generate_vapid_keys.py) ─────────────────
# Web push to the browsers and installed apps a person subscribed. Empty,
# nothing is pushed, and a person is told by email where email is set up.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── File storage ─────────────────────────────────────────────────────
# Uploaded files and approved agent packages are kept on the volumes.
FILE_STORAGE_PROVIDER=local

# A repository the Agents page may suggest as a source, with one click.
# Empty by default on purpose — a platform that shipped pointing at
# somebody else's repository would be choosing that for every deployment.
# The project's own agents are at https://github.com/decentai-io/decentai-agents.git;
# that address, or a fork's, is a sensible value.
REFERENCE_CATALOG_URL=

