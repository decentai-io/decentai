# This install's node authority's private key: node-issuer signs the
# bundled execution node's credentials with it. Compose gives this file
# to node-issuer alone — the Data Core and the seeder hold only the
# public half (NODE_AUTHORITY_PUBLIC_KEY, in config/deploy.env), and the node
# holds neither. bootstrap/setup.py writes config/node-authority.env; by hand,
# the first line `python bootstrap/generate_node_authority.py` prints.
NODE_AUTHORITY_PRIVATE_KEY=change-me
