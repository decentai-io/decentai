# The execution node's secret: what the AI Runtime and its Execution
# Sandboxes prove to each other. A sandbox registers with the runtime,
# and the runtime asks it for workers, each side answering the other's
# challenge with it; it never travels. Compose gives this file to the
# runtime and its sandboxes and to nothing else — not the Data Core.
# bootstrap/setup.py writes config/sandbox.env; by hand, any long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_RUNTIME_SANDBOX_SECRET=change-me
