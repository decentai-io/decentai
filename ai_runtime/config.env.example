# DecentAI private runtime configuration.
# Copy this file to config.env and replace every change-me value.
# docker-compose.yml hands the runtime these by name; this file is for
# a runtime started from the image by hand.

# Where the backend answers the services contract (/app).
BACKEND_INTERNAL_URL=http://backend:8000
# Where the agents' container answers, as host:port. Every process of
# an agent's is started there; the runtime starts none itself.
AI_RUNTIME_AGENTS_SPAWNER=agents:8003
AI_RUNTIME_HOST=0.0.0.0
AI_RUNTIME_PORT=8001
# Where installed agent code lives — the content store, the
# environments, the workers' homes — on the volume both containers
# hold at this path.
AI_RUNTIME_AGENTS_INSTALL_DIR=/data/agents

# Verifies that connections really came from the backend. The matching
# private key lives in the backend's config. Store the PEM on one line
# with \n escapes (bootstrap/generate_service_keys.py prints both halves
# ready to paste).
BACKEND_SERVICE_PUBLIC_KEY=change-me
# Signs the runtime's own identity toward the backend, for what it asks
# as itself: the approved packages, to stock itself with
# (docs/system/agent-code.md). The backend holds the public half.
# Required: a runtime without it does not start.
AI_RUNTIME_SERVICE_PRIVATE_KEY=change-me
