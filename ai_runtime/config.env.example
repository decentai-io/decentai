# DecentAI private runtime configuration.
# Copy this file to config.env and replace every change-me value.

# Where the backend answers the services contract (/app). Leave empty
# to run standalone on the in-memory sim.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
AI_RUNTIME_HOST=127.0.0.1
AI_RUNTIME_PORT=8001
# Where installed agent code lives — the content store and its
# references. Point it outside the source tree (a plain folder locally,
# a volume in a deployment); the default ai_runtime/installed_agents is
# only a fallback.
# AI_RUNTIME_AGENTS_INSTALL_DIR=/var/lib/decentai/agents

# Verifies that connections really came from the backend. The matching
# private key lives in the backend's config. Store the PEM on one line
# with \n escapes (bootstrap/generate_service_keys.py prints both halves
# ready to paste).
BACKEND_SERVICE_PUBLIC_KEY=change-me
