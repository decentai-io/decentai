# DecentAI private runtime configuration.
# Copy this file to config.env and replace every change-me value.
# docker-compose.yml hands the runtime these by name; this file is for
# a runtime started from the image by hand.

# Where the Data Core answers the services contract (/app).
DATA_CORE_INTERNAL_URL=http://data-core:8000
# The secret set for the execution node: what its Execution Sandboxes
# prove when they register here, and what the runtime proves to them.
# Every process of an agent's is started in a sandbox; the runtime
# starts none itself.
AI_RUNTIME_SANDBOX_SECRET=change-me
# Where the sandboxes register.
AI_RUNTIME_SANDBOX_PORT=8005
AI_RUNTIME_HOST=0.0.0.0
AI_RUNTIME_PORT=8001
# Where the approved packages are kept, to pass on to the sandboxes:
# the runtime's own folder, shared with no sandbox.
AI_RUNTIME_AGENTS_INSTALL_DIR=/data/agents

# The Data Core's public key: this execution node believes nothing it
# did not sign. The matching private key lives in the Data Core's
# config. Store the PEM on one line with \n escapes
# (bootstrap/generate_service_keys.py prints both halves ready to
# paste). An older name is read where this is not set
# (contracts/setting_names.py).
DATA_CORE_SERVICE_PUBLIC_KEY=change-me
# Where this node's credential is: a file its operator's secret manager
# keeps fresh, signed by an authority registered with the Data Core
# (docs/system/execution-nodes.md). Or AI_RUNTIME_NODE_CREDENTIAL_URL,
# an issuer the node asks. Required: a node without one is admitted
# nowhere, and never holds the authority's key itself.
AI_RUNTIME_NODE_CREDENTIAL_FILE=/run/decentai/node/credential
