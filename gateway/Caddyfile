# The engine's one public entry: TLS, the Data Core, and the web client.
#
# SITE_ADDRESS decides the certificate story — a real domain (with DNS
# pointing at this host) gets automatic Let's Encrypt certificates; a
# bare "localhost" or IP gets a self-signed certificate from Caddy's
# internal CA. Behind a load balancer that already terminates TLS this
# is ":80", and the Host header arrives intact for the matchers below.
#
# The Data Core's paths go to the Data Core. Every other path is the web
# client's, a separate repository (decentai-web-client) that serves the
# app's files, found as the web client section below says; the browser sees one
# origin, so the sign-in cookie and the allowed origins need nothing more.

# ── Whose word is taken for a client's address ──────────────────────
#
# Whatever connects here says where its request came from
# (X-Forwarded-For), and anybody can say anything. The word is taken
# only from the addresses named in TRUSTED_PROXIES — the load balancer
# in front, by its range — and from nobody where none is named: the
# Data Core is then told the address that connected, which is the truth.
#
# Without it, behind a balancer, every person is the balancer to the
# Data Core: the sign-in lockout that counts by address counts them as
# one, and a session's record names the balancer.
#
# The default names this container itself, which is nobody: a browser
# on the same computer arrives from the engine's own address, and is
# not to be believed about where it is.
{
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
	}
}

{$SITE_ADDRESS:localhost} {
	encode gzip

	# What every answer says about how it may be used: never guess a
	# content type, send no address to another site, never be shown in
	# another page's frame. The page's own policy (what it may load) is
	# the web client's to send with its pages.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
	}

	# ── The Data Core ─────────────────────────────────────────────────
	#
	# Authentication, the app gateway, storage, OAuth, webhooks, health,
	# and the chat WebSocket (Caddy proxies WebSockets and forwards
	# X-Forwarded-* natively). /healthz is here so a load balancer's
	# health check reaches the Data Core.
	@data_core path /auth/* /app /chats/* /upload /download/* /oauth/* /hooks/* /status /healthz /readyz /nodes/*
	handle @data_core {
		reverse_proxy {$DATA_CORE_UPSTREAM:backend:8000}
	}

	# ── The web client ────────────────────────────────────────────────
	#
	# Everything else: the app's pages and files, from the web client's
	# own server. Unsaid, the first that answers of its container, which
	# joins this stack's network as web-client, and `npm start` on this
	# computer's port 4200 while it is developed. WEB_CLIENT_UPSTREAM
	# names one, as host:port, where it runs somewhere else.
	handle {
		reverse_proxy {$WEB_CLIENT_UPSTREAM:web-client:80 host.docker.internal:4200} {
			lb_policy first
			lb_try_duration 2s
			fail_duration 10s
		}
	}

	# Nothing answering: say which half, and how to start it, rather
	# than a bare 502.
	handle_errors {
		@client_away {
			expression `{err.status_code} in [502, 503, 504]`
			not path /auth/* /app /chats/* /upload /download/* /oauth/* /hooks/* /status /healthz /readyz /nodes/*
		}
		respond @client_away "The DecentAI engine is running, but its web client is not answering. Start it from the decentai-web-client repository: docker compose up -d --build (or npm start)." 502
	}
}
