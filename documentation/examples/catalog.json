{
  "schema": 3,
  "catalog": {
    "id": "decentai_examples",
    "name": "DecentAI examples"
  },
  "agents": [
    {
      "manifest": {
        "schema": 3,
        "agent": {
          "id": "connection_check",
          "name": "Connection Check",
          "version": "0.2.0",
          "description": "See what an agent can reach from where it runs: the host it declared, one it never declared, an address inside the network, and a way around the platform.\n",
          "instructions": "Use this agent when the person wants to see whether agents are held to the hosts they declared. report runs the whole check; reach tries one address. Report every row as given: reached, refused, unreachable or not_tried are different things, and a refusal's reason is the platform's own words.\n",
          "examples": [
            {
              "title": "Check this install",
              "prompt": "Run the connection check and tell me what was reached and what was refused."
            },
            {
              "title": "Try one address",
              "prompt": "Ask Connection Check whether it can reach api.github.com."
            }
          ],
          "tags": [
            "diagnostics",
            "security"
          ]
        },
        "network": {
          "hosts": [
            "example.com"
          ]
        },
        "functions": [
          {
            "id": "report",
            "name": "Run the check",
            "description": "The whole check: the host this agent declared, a host it did not, an address inside the network, and a connection and a name lookup made past the platform's way out. Each row says what a held agent expects and what happened; held says whether every row went as expected.\n",
            "level": 0,
            "timeout_seconds": 90,
            "calls": [
              "chat"
            ],
            "inputs": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            },
            "outputs": {
              "type": "object",
              "required": [
                "held",
                "verdict",
                "rows"
              ],
              "properties": {
                "held": {
                  "type": "boolean"
                },
                "verdict": {
                  "type": "string"
                },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "attempt",
                      "target",
                      "expected",
                      "outcome",
                      "as_expected"
                    ],
                    "properties": {
                      "attempt": {
                        "type": "string"
                      },
                      "target": {
                        "type": "string"
                      },
                      "expected": {
                        "type": "string"
                      },
                      "outcome": {
                        "type": "string",
                        "enum": [
                          "reached",
                          "refused",
                          "unreachable",
                          "not_tried"
                        ]
                      },
                      "reason": {
                        "type": "string"
                      },
                      "as_expected": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "id": "reach",
            "name": "Try one address",
            "description": "Try one host, with a port when it is not 443 (host:8443), and say what happened.",
            "level": 0,
            "timeout_seconds": 45,
            "inputs": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "address"
              ],
              "properties": {
                "address": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            },
            "outputs": {
              "type": "object",
              "required": [
                "host",
                "port",
                "declared",
                "outcome"
              ],
              "properties": {
                "host": {
                  "type": "string"
                },
                "port": {
                  "type": "integer"
                },
                "declared": {
                  "type": "boolean"
                },
                "outcome": {
                  "type": "string",
                  "enum": [
                    "reached",
                    "refused",
                    "unreachable",
                    "not_tried"
                  ]
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        ]
      },
      "programs": {
        "x86_64": {
          "url": "connection_check/0.2.0/program.zip",
          "digest": "sha256:0b3eceb588ddc861bbfa9f398a8e074ced49e138941abf660490e54dc55ea169",
          "size": 2627
        },
        "aarch64": {
          "url": "connection_check/0.2.0/program.zip",
          "digest": "sha256:0b3eceb588ddc861bbfa9f398a8e074ced49e138941abf660490e54dc55ea169",
          "size": 2627
        }
      },
      "base": "python-3.12",
      "readme": "See what an agent can reach from where it runs: the host it declared, one it never declared, an address inside the network, and a way around the platform."
    },
    {
      "manifest": {
        "schema": 3,
        "agent": {
          "id": "probe",
          "name": "Probe",
          "version": "0.2.0",
          "description": "Tests a sandbox from inside: says what it can see and reach, and does on request what a sandbox must hold or end: using memory, starting children, writing files, writing what isn't a message, trying what a jail refuses.\n",
          "instructions": "A tool for testing a sandbox, not for a person's work. Call inspect to see what a process sees.\n",
          "tags": [
            "diagnostics"
          ]
        },
        "network": {
          "hosts": [
            "example.com"
          ]
        },
        "functions": [
          {
            "id": "inspect",
            "name": "Inspect",
            "description": "What this process sees and can reach.",
            "level": 0,
            "inputs": {
              "type": "object",
              "properties": {}
            },
            "outputs": {
              "type": "object"
            }
          },
          {
            "id": "echo",
            "name": "Echo",
            "description": "Its inputs back.",
