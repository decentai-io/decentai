# The images are built from the repository root and take only code:
# nothing a local run, a test or an editor left behind, and no settings.
.git
docs
**/.claude

# Settings and secrets
config/*.env
deploy.env
sandbox.env
node-authority.env
**/config.env
**/.env
**/*.pem
**/*.key

# Python leftovers
**/__pycache__
**/.pytest_cache
**/.venv
**/state.json

# What local runs and tests write
data_core/uploads
data_core/data
data_core/tests/.uploads
data_core/tests/.agent-packages
ai_runtime/installed_agents
ai_runtime/tests/.workerenv
**/.workerenv

# Frontend builds and caches
**/node_modules

# Editors
**/.idea
**/.vscode
