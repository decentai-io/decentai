# DecentAI backend configuration.
# Copy this file to config.env and replace every change-me value.

# Application URLs
PUBLIC_APP_URL=http://localhost:4200
CORS_ALLOW_ORIGINS=http://localhost:4200

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE_NAME=decentai

# Private AI runtime.
AI_RUNTIME_URL=http://localhost:8001
# A repository the Agents page may suggest as a source, with one click.
# Empty by default on purpose — a platform that shipped pointing at
# somebody else's repository would be choosing that for every deployment.
# The project's own agents are at https://github.com/decentai-io/decentai-agents.git;
# that address, or a fork's, is a sensible value.
REFERENCE_CATALOG_URL=
# Where providers send the browser back after a connected-app sign-in.
# In development the API has its own port, so name it here:
OAUTH_REDIRECT_URL=http://localhost:8000/oauth/callback

# Signs the backend's identity toward the runtime; the runtime holds the
# matching public key. Store the PEM on one line with \n escapes
# (bootstrap/generate_service_keys.py prints both halves ready to paste).
BACKEND_SERVICE_PRIVATE_KEY=change-me

# Initial organization and administrator (used during first-run seeding)
ORG_NAME=DecentAI
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Authentication
# Generate a long random value independently for this deployment.
TOKEN_SECRET_KEY=change-me
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=lax

# Reverse proxy. When the backend sits behind one, list the proxy IPs
# whose X-Forwarded-* headers are trusted (comma-separated, or "*"
# inside a private network). Direct local development needs no change.
FORWARDED_ALLOW_IPS=127.0.0.1

# Encrypted data
# Versioned AES-256-GCM keys — bootstrap/generate_secret_keys.py prints
# both lines ready to paste (and --rotate handles key rotation).
SECRET_ENCRYPTION_KEYS=01:change-me
SECRET_ENCRYPTION_ACTIVE=01

# File storage
FILE_STORAGE_PROVIDER=local
UPLOADS_DIR=uploads

# Where approved agent code is kept (<org_id>/<digest>.tar.gz). This is
# the only copy of an installed agent that the platform controls — a
# repository can be deleted or force-pushed, this cannot.
AGENT_PACKAGE_DIR=data/agent-packages
